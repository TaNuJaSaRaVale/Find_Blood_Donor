# Copy this file to ".env" and fill in your values:   cp .env.example .env

# Port the API listens on
PORT=5000

# ---- MongoDB connection string ----
# Option A: Local MongoDB (installed on your laptop or running in Docker)
MONGO_URI=""
# Option B: MongoDB Atlas (cloud) - paste the string from Atlas > Connect > Drivers
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/raktsetu?retryWrites=true&w=majority

# Secret used to sign login tokens (JWT). Use any long random string.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Which frontends may call this API (comma separated). "*" allows all.
CORS_ORIGIN=*

NODE_ENV=development
